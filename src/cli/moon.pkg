import {
  "PingGuoMiaoMiao/moondraw/kernel" @k,
  "PingGuoMiaoMiao/moondraw/elk_layout" @elk_layout,
  "moonbitlang/async" @async,
  "moonbitlang/async/fs" @fs,
  "moonbitlang/async/stdio" @stdio,
  "moonbitlang/core/env" @env,
}

// The CLI is a native tool: it reads files through moonbitlang/async, which has
// no JS implementation. Keeping it native-only also keeps the module's default
// JS build free of filesystem code.
supported_targets = "+native"

pkgtype(kind: "executable")

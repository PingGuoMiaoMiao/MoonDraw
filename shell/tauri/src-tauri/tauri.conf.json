{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoonDraw",
  "version": "0.1.0",
  "identifier": "com.moondraw.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MoonDraw",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "MoonBit flowchart and whiteboard editor",
    "longDescription": "A flowchart / whiteboard editor whose entire UI logic is written in MoonBit."
  }
}
